# .env.example – copy this file to .env and fill in your values.
# .env is git-ignored; never commit real secrets to version control.

# ─── Flask secret key ───────────────────────────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-real-random-secret-key

# ─── Flask environment ──────────────────────────────────────────────────────
# Options: development | testing | production
FLASK_ENV=development

# ─── Optional: custom database path ────────────────────────────────────────
# Defaults to traffic_data.db in the project root if not set.
# DATABASE_PATH=/path/to/your/traffic_data.db
